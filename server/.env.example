# ===========================================
# Gumroad Configuration
# ===========================================
# Get Access Token from: https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your_access_token_here
GUMROAD_USERNAME=rajputxv
GUMROAD_SELLER_ID=your_seller_id_here

# Product Permalinks (the short URLs you set when creating products)
GUMROAD_PRO_MONTHLY_PERMALINK=health-report-analyzer-client-month
GUMROAD_PRO_YEARLY_PERMALINK=health-report-analyzer-client-year

# Product Short IDs (sent by Gumroad in webhooks - found in webhook logs)
GUMROAD_PRODUCT_SHORT_ID_MONTH=your_monthly_short_id
GUMROAD_PRODUCT_SHORT_ID_YEAR=your_yearly_short_id

# Product IDs (for license key verification)
GUMROAD_PRODUCT_ID_MONTH=your_monthly_product_id
GUMROAD_PRODUCT_ID_YEAR=your_yearly_product_id

# ===========================================
# Existing Configuration
# ===========================================
PORT=5001
MONGODB_URI=mongodb://localhost:27017/health-analyzer
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173

# Email (for password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Contact form (Web3Forms) - moved server-side so the key is never shipped to the browser.
# Get it from https://web3forms.com. Remove VITE_WEB3FORMS_ACCESS_KEY from the client .env.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# ===========================================
# Firebase Admin (REQUIRED for Google sign-in)
# ===========================================
# The server verifies the Firebase ID token sent by the client after Google sign-in.
# Provide ONE of the following. Until set, /api/auth/google-auth rejects all requests.
#
# Option 1 - full service-account JSON on a single line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
#
# Option 2 - individual fields (escape newlines in the private key as \n):
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option 3 - path to a service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Environment
NODE_ENV=development
