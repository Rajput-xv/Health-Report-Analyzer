# ===========================================
# Gumroad Configuration
# ===========================================
# Get Access Token from: https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your_access_token_here
GUMROAD_USERNAME=rajputxv
GUMROAD_SELLER_ID=your_seller_id_here

# Product Permalinks (the short URLs you set when creating products)
GUMROAD_PRO_MONTHLY_PERMALINK=health-report-analyzer-client-month
GUMROAD_PRO_YEARLY_PERMALINK=health-report-analyzer-client-year

# Product Short IDs (sent by Gumroad in webhooks - found in webhook logs)
GUMROAD_PRODUCT_SHORT_ID_MONTH=your_monthly_short_id
GUMROAD_PRODUCT_SHORT_ID_YEAR=your_yearly_short_id

# Product IDs (for license key verification)
GUMROAD_PRODUCT_ID_MONTH=your_monthly_product_id
GUMROAD_PRODUCT_ID_YEAR=your_yearly_product_id

# ===========================================
# Existing Configuration
# ===========================================
PORT=5001
MONGODB_URI=mongodb://localhost:27017/health-analyzer
JWT_SECRET=your_jwt_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
FRONTEND_URL=http://localhost:5173

# Email (for password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Environment
NODE_ENV=development
